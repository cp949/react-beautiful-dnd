{
  "name": "@cp949/react-beautiful-dnd",
  "version": "1.0.2",
  "private": false,
  "description": "Beautiful and accessible drag and drop for lists with React",
  "author": "Alex Reardon <areardon@atlassian.com>",
  "contributors": [
    "Gabriel Santerre <gab@100terres.com>",
    "Reece Carolan <reece@hellopangea.com>"
  ],
  "maintainers": [
    "jjfive <ohlab.kr@gmail.com>"
  ],
  "keywords": [
    "drag and drop",
    "dnd",
    "sortable",
    "reorder",
    "reorderable",
    "react",
    "react.js",
    "natural",
    "beautiful",
    "accessible"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cp949/react-beautiful-dnd.git"
  },
  "bugs": {
    "url": "https://github.com/cp949/react-beautiful-dnd/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.11.0"
  },
  "main": "dist/react-beautiful-dnd.cjs.js",
  "module": "dist/react-beautiful-dnd.esm.js",
  "types": "dist/react-beautiful-dnd.d.ts",
  "sideEffects": false,
  "files": [
    "/dist",
    "/src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "config": {
    "format_target": "*.{js,jsx,ts,tsx,md,json} src/**/*.{js,jsx,ts,tsx,md,json} test/**/*.{js,jsx,ts,tsx,md,json} docs/**/*.{js,jsx,ts,tsx,md,json} stories/**/*.{js,jsx,ts,tsx,md,json} cypress/**/*.{js,jsx,ts,tsx,md,json} csp-server/**/*.{js,jsx,ts,tsx,md,json}"
  },
  "scripts": {
    "commit": "cz",
    "prepare": "husky",
    "release": "release-it",
    "release:test": "release-it --dry-run",
    "test:accessibility": "lighthouse http://localhost:9002/iframe.html?id=examples-single-vertical-list--basic --no-enable-error-reporting --config-path=lighthouse.config.js --chrome-flags='--headless' --output=json --output=html --output-path=./test-reports/lighthouse/a11y.json && node a11y-audit-parse.js",
    "test": "vitest run",
    "test:react-18": "cross-env REACT_MAJOR_VERSION=18 pnpm test",
    "test:react-19": "cross-env REACT_MAJOR_VERSION=19 pnpm test",
    "test:browser": "cypress open",
    "test:browser:ci": "cypress run",
    "test:coverage": "pnpm test --coverage",
    "validate": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm typecheck",
    "format:check": "oxfmt --check $npm_package_config_format_target",
    "format:write": "oxfmt --write $npm_package_config_format_target",
    "lint": "oxlint",
    "lint:css": "stylelint \"stories/**/*.{js,jsx,ts,tsx}\"",
    "typecheck": "pnpm typecheck:lib && pnpm typecheck:test && pnpm typecheck:storybook",
    "typecheck:lib": "pnpm tsc --project tsconfig.json",
    "typecheck:storybook": "pnpm tsc --project stories/tsconfig.json && pnpm tsc --project .storybook/tsconfig.json",
    "typecheck:test": "pnpm tsc --project test/tsconfig.json && pnpm tsc --project csp-server/tsconfig.json && pnpm tsc --project cypress/tsconfig.json",
    "bundle-size:check": "cross-env SNAPSHOT=match pnpm bundle-size:update",
    "bundle-size:update": "pnpm build:clean && pnpm build:dist && pnpm build:clean",
    "build": "pnpm build:clean && pnpm build:dist",
    "build:clean": "rimraf dist",
    "build:dist": "tsdown",
    "storybook": "storybook dev -p 9002",
    "build-storybook": "storybook build -c .storybook -o site",
    "prepublishOnly": "node ./scripts/publish-guard.mjs && pnpm build"
  },
  "dependencies": {
    "css-box-model": "^1.2.1",
    "raf-schd": "^4.0.3",
    "react-redux": "^9.3.1",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@babel/plugin-transform-class-properties": "8.0.1",
    "@babel/plugin-transform-modules-commonjs": "8.1.2",
    "@babel/plugin-transform-private-methods": "8.0.1",
    "@babel/plugin-transform-private-property-in-object": "8.0.5",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/cz-commitlint": "21.2.4",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-webpack5-compiler-swc": "4.0.3",
    "@storybook/react": "10.6.7",
    "@storybook/react-webpack5": "10.6.7",
    "@swc/core": "1.16.22",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/express": "5.0.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/raf-schd": "4.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/seedrandom": "3.0.8",
    "@vitest/coverage-v8": "5.1.0",
    "babel-loader": "10.1.1",
    "babel-plugin-dev-expression": "0.2.3",
    "babel-plugin-module-resolver": "5.0.3",
    "browserslist": "4.29.5",
    "commitizen": "4.3.2",
    "cross-env": "10.1.0",
    "csstype": "3.2.3",
    "cypress": "16.3.0",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "husky": "9.1.7",
    "jest-axe": "11.0.0",
    "jsdom": "31.0.1",
    "lighthouse": "13.6.0",
    "memory-fs": "0.5.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "postcss-styled-syntax": "0.7.4",
    "raf-stub": "3.0.0",
    "react": "19.3.1",
    "react-18": "npm:react@18.3.1",
    "react-dom": "19.3.1",
    "react-dom-18": "npm:react-dom@18.3.1",
    "react-window": "2.5.3",
    "release-it": "21.1.2",
    "require-from-string": "2.0.2",
    "rimraf": "6.1.4",
    "seedrandom": "3.0.5",
    "storybook": "10.6.7",
    "styled-components": "6.6.0",
    "stylelint": "18.0.0",
    "stylelint-config-recommended": "19.0.0",
    "stylelint-config-standard": "41.0.0",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wait-on": "9.5.1",
    "webpack": "5.112.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.21.0"
}
